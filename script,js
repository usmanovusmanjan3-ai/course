// ================= COURSE OPEN =================

function openCourse(courseName) {

    const course = courses[courseName];

    if (!course) return;


    document.getElementById("courseModalIcon")
        .textContent = course.icon;


    document.getElementById("courseModalCategory")
        .textContent = course.category;


    document.getElementById("courseModalTitle")
        .textContent = course.title;


    document.getElementById("courseModalDescription")
        .textContent = course.description;


    document
        .getElementById("courseModal")
        .classList.add("active");

}


// ================= COURSE CLOSE =================

function closeCourse() {

    document
        .getElementById("courseModal")
        .classList.remove("active");

}


