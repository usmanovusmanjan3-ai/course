// ================= VELORA LOGIN =================

// Rollar va parollar
const passwords = {
    student: "1111",
    teacher: "2222",
    admin: "0000"
};

let selectedRole = "student";


// ================= ROL TANLASH =================

function selectRole(role, button) {

    selectedRole = role;

    document.querySelectorAll(".role-tab").forEach(tab => {
        tab.classList.remove("active");
    });

    button.classList.add("active");

    document.getElementById("password").value = "";
    document.getElementById("loginMessage").textContent = "";
}


// ================= LOGIN =================

function login() {

    const password =
        document.getElementById("password").value.trim();

    const message =
        document.getElementById("loginMessage");


    if (!password) {

        message.textContent =
            "Iltimos, parolni kiriting!";

        return;
    }


    // Admin parolini istalgan rolda ham qabul qiladi
    if (password === passwords.admin) {

        openPage("adminPage");

        return;
    }


    if (password !== passwords[selectedRole]) {

        message.textContent =
            "Parol noto‘g‘ri!";

        return;
    }


    message.textContent = "";


    if (selectedRole === "student") {

        openPage("studentPage");

        showSection("homeSection");

    }


    if (selectedRole === "teacher") {

        openPage("teacherPage");

    }

}


// ================= PASSWORD KO‘RISH =================

function togglePassword() {

    const input =
        document.getElementById("password");

    const eye =
        document.getElementById("eyeButton");


    if (input.type === "password") {

        input.type = "text";

        eye.textContent = "🙈";

    } else {

        input.type = "password";

        eye.textContent = "👁";

    }

}


// ================= PAGE OCHISH =================

function openPage(pageId) {

    document.querySelectorAll(".page").forEach(page => {

        page.classList.remove("active");

    });

    document
        .getElementById(pageId)
        .classList.add("active");

    window.scrollTo(0, 0);
}


// ================= STUDENT SECTION =================

function showSection(sectionId) {

    document
        .querySelectorAll(".student-section")
        .forEach(section => {

            section.classList.remove("active-section");

            section.style.display = "none";

        });


    const section =
        document.getElementById(sectionId);


    if (section) {

        section.classList.add("active-section");

        section.style.display = "block";

    }

    window.scrollTo(0, 0);
}


